# =============================================================================
# .env.example — Config Service (real-config-back)
# Microservicio de configuración centralizada del ecosistema SaaS multi-tenant
#
# Copiar a .env y completar los valores reales antes de levantar el servicio.
# NUNCA commitear el .env real al repositorio.
# =============================================================================

# ─── Servidor ────────────────────────────────────────────────────────────────
# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto en el que escucha el servidor (default: 3001)
# En Docker la imagen expone este mismo puerto (ver Dockerfile EXPOSE 3001)
PORT=3001

# ─── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# Usado por: PrismaService (PrismaPg adapter), prisma.config.ts, migraciones
# Formato:   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/config_service?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
# Usado por: RedisService (ioredis), BullModule (cola webhook-delivery)
# RedisService → process.env['REDIS_URL'] ?? 'redis://localhost:6379'
# BullModule   → connection: { url: process.env['REDIS_URL'] }
REDIS_URL=redis://localhost:6379

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Usado por: FirebaseModule → admin.initializeApp()
#            FirebaseAuthGuard → admin.app().auth().verifyIdToken()
#            StepUpGuard → admin.app().auth().verifyIdToken()
#
# Obtener en Firebase Console → Configuración del proyecto → Cuentas de servicio
#   → Generar nueva clave privada (descarga JSON)
FIREBASE_PROJECT_ID=mi-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mi-proyecto-firebase.iam.gserviceaccount.com
# Los saltos de línea de la private key deben ser literales \n (no newlines reales)
# El código hace: privateKey.replace(/\\n/g, '\n')  → se escapa correctamente
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkq...(resto de la clave)...\n-----END PRIVATE KEY-----\n"

# ─── Seguridad — Cifrado de secretos (SecretConfig) ───────────────────────────
# Usado por: CryptoService → AES-256-GCM
# Debe ser exactamente 32 caracteres (256 bits) o una clave hex de 64 chars
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=cambia_esto_por_una_clave_de_32_caracteres_min

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Usado por: main.ts → app.enableCors()
# Default si no se define: ['http://localhost:3000']
# Separar múltiples orígenes con coma: http://localhost:3000,https://app.ejemplo.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# ─── Cache TTL (segundos) ─────────────────────────────────────────────────────
# Usado por: ConfigFlagsService → FLAG_TTL
# Default si no se define: 60 segundos
CONFIG_CACHE_TTL_FLAGS=60

# ─── Webhooks — delivery worker ───────────────────────────────────────────────
# Usado por: WebhookDeliveryProcessor y WebhookDeliveryService
# WEBHOOK_DELIVERY_TIMEOUT → ms de timeout por intento de entrega (default: 5000)
# WEBHOOK_MAX_RETRIES      → intentos máximos por job en BullMQ (default: 3)
WEBHOOK_DELIVERY_TIMEOUT=5000
WEBHOOK_MAX_RETRIES=3

# ─── Throttling — rate limiting global ────────────────────────────────────────
# Configurado en AppModule con valores hardcodeados (no leídos de env).
# Documentado aquí solo como referencia de los límites activos:
#   short → 15 req / 1 seg  (anti-burst)
#   long  → 100 req / 60 seg (ventana de 1 minuto)
# Para cambiar estos valores editar directamente src/app.module.ts
# THROTTLE_SHORT_TTL=1000
# THROTTLE_SHORT_LIMIT=15
# THROTTLE_LONG_TTL=60000
# THROTTLE_LONG_LIMIT=100
