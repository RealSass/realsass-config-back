# pnpm requiere aprobación explícita de postinstall scripts desde v9+
# Sin esto: ERR_PNPM_IGNORED_BUILDS bloquea prisma, bcrypt, firebase, etc.
# Estos son los paquetes que necesitan correr scripts en install/postinstall:

approve-builds[]=prisma
approve-builds[]=@prisma/engines
approve-builds[]=bcrypt
approve-builds[]=@nestjs/core
approve-builds[]=@firebase/util
approve-builds[]=msgpackr-extract
approve-builds[]=protobufjs
approve-builds[]=unrs-resolver
