# pnpm v9+ requiere lista explícita de paquetes autorizados a correr scripts
# La clave es onlyBuiltDependencies (reemplaza approve-builds que fue removido)
# Todos los paquetes del ERR_PNPM_IGNORED_BUILDS deben estar aquí

onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=bcrypt
onlyBuiltDependencies[]=@nestjs/core
onlyBuiltDependencies[]=@firebase/util
onlyBuiltDependencies[]=msgpackr-extract
onlyBuiltDependencies[]=protobufjs
onlyBuiltDependencies[]=unrs-resolver
