  // ── Temas del sistema ──────────────────────────────────────────────────────
  const themes = [
    {
      name: 'Default', isSystemDefault: true, isActive: false,
      primaryColor: '#000000', secondaryColor: '#ffffff', fontFamily: 'DM Sans',
      borderRadius: '0.75rem', darkMode: false,
    },
